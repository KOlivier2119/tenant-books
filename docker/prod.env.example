# Copy to docker/prod.env and change the three secrets before starting
# docker/compose.prod.yaml.  docker/prod.env is git-ignored on purpose; if it
# ever needs to live in a repository, Part 6 replaces it with Sealed Secrets.
#
#   docker compose --env-file docker/prod.env -f docker/compose.prod.yaml up -d

# --- required, no defaults: compose refuses to start without them ---
DB_ROOT_PASSWORD=local-dev-only-root-password
ADMIN_PASSWORD=local-dev-only-admin-password
WEBHOOK_SECRET=local-dev-only-hmac-secret

# --- image built by docker/custom/Containerfile ---
CUSTOM_IMAGE=tenantbooks
CUSTOM_TAG=v15.103.0

# --- site identity ---
SITE_NAME=tenantbooks.localhost
FRAPPE_HOST_NAME=tenantbooks.localhost
FRAPPE_WEBSERVER_PORT=8080

# --- where the signed webhook goes ---
WEBHOOK_URL=http://mock-receiver:8071/hook

# --- host ports (8080/8071 stay free for the dev stack) ---
WEB_PORT=8081
RECEIVER_PORT=8072

# --- web process sizing (explained in the Part 7 Gunicorn notes) ---
# workers ~= (2 x cpu cores) + 1 for a gthread workload; this laptop demo runs
# 1, a 2-cpu pod runs 3.  Keep them low until you have measured.
GUNICORN_WORKERS=1
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=120
GUNICORN_MAX_REQUESTS=5000
